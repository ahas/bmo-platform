{
  "line_20": "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n    <style>body { margin: 0 } * { box-sizing: border-box }</style>\n    <div id=\"__nuxt\" style=\"isolation:isolate\">\n      <div style=\"position:fixed;inset:0;display:flex\">\n        <div style=\"position:relative;display:flex;flex-direction:column;flex:1\">\n          <div data-overlay=\"top bar\" style=\"position:absolute;inset-inline:0;top:0;z-index:20;height:60px;background:#fffc\">방</div>\n          <div style=\"flex:1;overflow-y:auto;padding:60px 0 80px\">\n            <div data-flight-layer style=\"position:relative;isolation:isolate;display:flex;flex-direction:column;gap:16px;padding:16px\">\n              <div data-overlay=\"day mark\" style=\"position:sticky;top:12px;z-index:10;align-self:center;background:#ddd\">10월 8일</div>\n              <div data-row=\"one\" style=\"position:relative;height:120px\">앞선 말</div>\n              <div data-row=\"two\"><div data-bubble style=\"width:240px;padding:8px;background:#9cf;border-radius:12px\"><p data-words style=\"margin:0\">새 답</p></div></div>\n              <div data-flight-host style=\"display:contents\"></div>\n            </div>\n          </div>\n          <div data-overlay=\"way down\" style=\"position:absolute;right:16px;bottom:96px;z-index:10;width:40px;height:40px;background:#fff\">↓</div>\n          <div data-overlay=\"input bar\" style=\"position:absolute;inset-inline:0;bottom:0;z-index:20;height:80px;background:#fffc\"><textarea></textarea></div>\n        </div>\n      </div>\n      <div data-overlay=\"notice\" style=\"position:fixed;inset-inline:0;top:320px;z-index:100;margin:auto;width:120px;height:30px;background:#fec\">알림</div>\n    </div>\n    "
}
