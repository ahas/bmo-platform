{
  "name": "@agency/client",
  "version": "0.1.0-rev.12",
  "description": "The agency's client, generated from its OpenAPI document: every body as a type and a typed call for every route.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "src/index.ts",
    "src/schema.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/openapi.json --output src/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
